{
  "name": "turtlepen",
  "version": "0.3.3",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Meteoryte/turtlepen.git"
  },
  "description": "TurtlePen \u2014 an integer-exact grid substrate for AI-authored diagrams: a turtle/pen command language, measurement before placement, severity-ranked collision reporting, and Z-page overlays.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.js\"",
    "test:endpoints": "node --test test/endpoints.test.js test/http-mcp.test.js test/mcp.test.js test/viewer.test.js",
    "viewer": "node src/viewer/server.js",
    "mcp": "node src/mcp/server.js",
    "mcp:http": "node src/mcp/http-server.js",
    "cli": "node src/cli.js",
    "doctor": "node src/cli.js doctor",
    "governance": "node src/cli.js governance",
    "docs:help": "node src/cli.js help --manual --out docs/turtlepen-help.txt",
    "quality:manifest": "node src/cli.js manifest --out artifacts/manifest.json",
    "benchmark:worksheet": "node src/cli.js benchmark worksheet --out benchmark/worksheet.json",
    "example": "node examples/build-example.js",
    "session": "node examples/agent-session.js",
    "stress": "node examples/constraint-stress.js",
    "rework": "node examples/rework-session.js",
    "vector-repair": "node examples/vector-repair-session.js",
    "field-guide": "node examples/build-condenser-field-guide.js",
    "image-session": "node examples/image-session.js",
    "random-images": "node examples/supersample-random-five.js",
    "logo": "node brand/build-logo.mjs",
    "tree": "node examples/branching-tree.js",
    "check": "node --test \"test/**/*.test.js\" && node examples/build-example.js && node examples/agent-session.js --quiet && node examples/constraint-stress.js --quiet && node examples/rework-session.js --quiet && node examples/vector-repair-session.js --quiet && node examples/crt-desk-scene.js --quiet && node examples/showcase-revision.js --quiet && node examples/showcase-atlas.js --quiet && node brand/build-logo.mjs && node examples/branching-tree.js && node examples/build-condenser-field-guide.js && node examples/image-session.js && node examples/supersample-random-five.js && node build-flowchart.js && node build-swimlane.js && node src/cli.js help --manual --out docs/turtlepen-help.txt && node src/cli.js manifest --out artifacts/manifest.json --enforce && node src/cli.js governance",
    "quickstart": "node examples/build-example.js",
    "crt": "node examples/crt-desk-scene.js",
    "revision": "node examples/showcase-revision.js",
    "atlas": "node examples/showcase-atlas.js",
    "font:floor": "node examples/turtlefont-floor.js"
  },
  "dependencies": {},
  "devDependencies": {},
  "bin": {
    "turtlepen-mcp": "src/mcp/server.js",
    "turtlepen-mcp-http": "src/mcp/http-server.js",
    "turtlepen": "src/cli.js"
  },
  "exports": {
    ".": "./src/core/index.js",
    "./mcp": "./src/mcp/server.js",
    "./mcp/http": "./src/mcp/http-server.js",
    "./mcp/cloudflare": "./src/mcp/cloudflare.js",
    "./mcp/protocol": "./src/mcp/protocol.js",
    "./tools": "./src/mcp/tools.js"
  },
  "files": [
    "src",
    "README.md",
    "CHANGELOG.md",
    "llm.md",
    "status.md",
    "docs/QUICKSTART.md",
    "docs/remote-mcp.md",
    "docs/adr/0001-one-model-many-views.md",
    "docs/adr/0002-conflict-aware-local-persistence.md",
    "docs/adr/0003-deterministic-output-and-micro-masks.md",
    "docs/source-of-truth-map.md",
    "docs/turtlepen-help.txt",
    "benchmark/README.md",
    "benchmark/corpus-v1.json",
    "artifacts/artifact-catalog.json",
    "artifacts/manifest.json",
    "LICENSE"
  ],
  "keywords": [
    "mcp",
    "diagram",
    "svg",
    "flowchart",
    "agent",
    "ai",
    "lattice",
    "validation"
  ]
}
